NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Só no servidor (nunca NEXT_PUBLIC_): grava as mensagens do contato. Supabase → Settings → API Keys → Secret keys
SUPABASE_SECRET_KEY=sb_secret_...
# Antispam do contato (Cloudflare Turnstile). As duas são obrigatórias: sem elas o formulário recusa os envios.
# Para desenvolvimento, use as chaves de teste da Cloudflare: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Opcional: domínio próprio (ex.: https://seunome.dev). Na Vercel, o domínio de produção é detectado sozinho.
NEXT_PUBLIC_SITE_URL=

# Formulário de contato: aviso de mensagem nova por e-mail (Resend). Sem a chave, as mensagens só ficam no painel.
RESEND_API_KEY=
# Quem recebe o aviso (padrão: e-mail do Perfil no painel)
CONTACT_TO_EMAIL=
# Remetente (padrão: onboarding@resend.dev, que só entrega no e-mail da conta Resend; troque após verificar um domínio)
CONTACT_FROM_EMAIL=
